# ---------------------------------------------------------------------------
# AI Decision Engine V2 - environment template (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# Application
APP_NAME=AI-Decision-Engine-V2
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=0.0.0.0
API_PORT=8000
PRELOAD_MODELS_ON_STARTUP=false

# Relational database (SQLite for local dev; PostgreSQL in deployment)
DATABASE_URL=sqlite:///./data/processed/funds.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/funds
DATABASE_ECHO=false

# Qdrant vector store (falls back to in-memory when unreachable and QDRANT_FALLBACK_IN_MEMORY=true)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fund_documents
QDRANT_PREFER_GRPC=false
QDRANT_FALLBACK_IN_MEMORY=true

# Embedding & cross-encoder models (CPU friendly defaults)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

# Chunking & retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_SPARSE_TOP_K=30
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_RRF_K=60
RERANK_TOP_K=12
EVIDENCE_CHUNKS_PER_FUND=3
MAX_STRUCTURED_CANDIDATES=25

# Decision engine weights (must sum to 1.0; rationale in docs/decision_engine.md)
WEIGHT_RISK_ADJUSTED_RETURN=0.35
WEIGHT_EXPENSE_EFFICIENCY=0.20
WEIGHT_DOWNSIDE_PROTECTION=0.15
WEIGHT_PREFERENCE_FIT=0.15
WEIGHT_EVIDENCE_QUALITY=0.10
WEIGHT_AUM_CONTEXT=0.05
UNKNOWN_CONSTRAINT_PENALTY=0.10
RISK_FREE_RATE=0.065

# Confidence & abstention
CONFIDENCE_HIGH_THRESHOLD=0.70
CONFIDENCE_MEDIUM_THRESHOLD=0.45
MIN_SCORE_MARGIN=0.03
MIN_EVIDENCE_CHUNKS_FOR_GENERATION=1
DATA_FRESHNESS_DAYS=400
ABSTAIN_ON_LOW_CONFIDENCE=false

# LLM provider: "gemini" (requires GEMINI_API_KEY) or "mock" (offline/test only)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_USE_FOR_QUERY_ANALYSIS=false
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
